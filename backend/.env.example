# =============================================
# Backend - Variables de entorno
# Copiar este archivo a .env y ajustar valores
# =============================================

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
# Alternativa con mDNS: MQTT_BROKER_HOST=mqtt.local
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=sensors
MQTT_CLIENT_ID=backend_worker_01

# --- Base de datos ---
DATABASE_URL=sqlite:///./data/workshop.db

# --- Modelo ML ---
MODEL_PATH=./models/model_rf.pkl
SCALER_PATH=./models/scaler.pkl
LABEL_ENCODER_PATH=./models/label_encoder.pkl

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# --- Ventana de datos ---
# Debe coincidir con WINDOW_SIZE del firmware
WINDOW_SIZE=50
SAMPLE_RATE_HZ=100
